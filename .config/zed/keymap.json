[
	// Window's navigation
	{
		"context": "Dock || Terminal || Editor",
		"bindings": {
			// Window's motions
			"ctrl-h": "workspace::ActivatePaneLeft",
			"ctrl-l": "workspace::ActivatePaneRight",
			"ctrl-k": "workspace::ActivatePaneUp",
			"ctrl-j": "workspace::ActivatePaneDown",
			"ctrl-/": "workspace::ToggleBottomDock"
		}
	},
	{
		"context": "GitPanel",
		"bindings": {
			"q": "git_panel::Close"
		}
	},
	{
		"context": "AgentPanel",
		"bindings": {
			"ctrl-\\": "workspace::ToggleRightDock",
			"cmd-k": "workspace::ToggleRightDock"
		}
	},
	// File panel (netrw)
	{
		"context": "ProjectPanel && not_editing",
		"bindings": {
			"a": "project_panel::NewFile",
			"A": "project_panel::NewDirectory",
			"r": "project_panel::Rename",
			"d": "project_panel::Delete",
			"x": "project_panel::Cut",
			"c": "project_panel::Copy",
			"p": "project_panel::Paste",
			// Close project panel as project file panel on the right
			"q": "workspace::ToggleLeftDock",
			", e": "workspace::ToggleLeftDock",
			":": "command_palette::Toggle",
			"%": "project_panel::NewFile",
			"/": "project_panel::NewSearchInDirectory",
			"enter": "project_panel::OpenPermanent",
			"escape": "project_panel::ToggleFocus",
			"h": "project_panel::CollapseSelectedEntry",
			"j": "menu::SelectNext",
			"k": "menu::SelectPrevious",
			"l": "project_panel::ExpandSelectedEntry",
			"o": "project_panel::OpenPermanent",
			"shift-d": "project_panel::Delete",
			"shift-r": "project_panel::Rename",
			"t": "project_panel::OpenPermanent",
			"v": "project_panel::OpenPermanent",
			"shift-g": "menu::SelectLast",
			"g g": "menu::SelectFirst",
			"-": "project_panel::SelectParent",
			"ctrl-6": "pane::AlternateFile"
		}
	},
	// 'dashboard view' from neovim (no buffer)
	{
		"context": "EmptyPane || SharedScreen",
		"bindings": {
		    ", e": "workspace::ToggleLeftDock",
			// Open file finder
			", space": "file_finder::Toggle",
			// New file
			", f n": "workspace::NewFile",
			// Open recent project
			", f p": "projects::OpenRecent",
			// Search in all the files
			", s g": "workspace::NewSearch",
			// Quit zed
			", q q": "zed::Quit"
		}
	},
	{
		"context": "Editor && VimControl && !VimWaiting && !menu",
		"bindings": {
		    // Folds
            "z shift-m": "editor::FoldAtLevel_1",
            "z shift-o": "editor::UnfoldRecursive",
			// Refactoring
			", c r": "editor::Rename",
			// Chat with AI
			", a a": "agent::ToggleFocus",
			"ctrl-\\": "workspace::ToggleRightDock",
			"cmd-k": "workspace::ToggleRightDock",
			", a e": "assistant::InlineAssist",
			"cmd-l": "assistant::InlineAssist",
			", a t": "workspace::ToggleRightDock",
			// Git
			", g g": [
				"task::Spawn",
				{
					"task_name": "lazygit",
					"reveal_target": "center"
				}
			],
			", g h d": "editor::ExpandAllDiffHunks",
			", g h D": "git::Diff",
			", g h r": "git::Restore",
			", g h R": "git::RestoreFile",
			// Toggle inlay hints
			", u i": "editor::ToggleInlayHints",
			// Toggle soft wrap
			", u w": "editor::ToggleSoftWrap",
			// Open markdown preview
			", m p": "markdown::OpenPreview",
			", m P": "markdown::OpenPreviewToTheSide",
			// Open recent project
			", f p": "projects::OpenRecent",
			// Search word under cursor in current pane
			// (can also use *)
			", s w": "buffer_search::Deploy",
			// Search word under cursor in all panes
			"space s W": "pane::DeploySearch",
			// Tab things. Almost as good as harpoon.
			", 1": ["pane::ActivateItem", 0],
			", 2": ["pane::ActivateItem", 1],
			", 3": ["pane::ActivateItem", 2],
			", 4": ["pane::ActivateItem", 3],
			", 5": ["pane::ActivateItem", 4],
			", 6": ["pane::ActivateItem", 5],
			", 7": ["pane::ActivateItem", 6],
			", 8": ["pane::ActivateItem", 7],
			", 9": ["pane::ActivateItem", 8],
			", 0": "pane::ActivateLastItem",
			"] b": "pane::ActivateNextItem",
			"[ b": "pane::ActivatePreviousItem",
			", ,": "tab_switcher::Toggle",
			// Jump to the previous location
			", b b": "pane::AlternateFile",
			// Close buffer
			", b d": "pane::CloseActiveItem",
			// Close inactive buffers
			", b q": "pane::CloseOtherItems",
			// New file
			", b n": "workspace::NewFile",
			// Search in the current buffer
			", s b": "vim::Search",
			// Search in all the files
			", s g": "workspace::NewSearch",
			// Make empty buffer
			", f n": "workspace::NewFile",
			// Search
			", /": "workspace::NewSearch",
			// Git
			", g b": "git::Blame",
			// LSP & Code actions
			", c a": "editor::ToggleCodeActions",
			", s d": "diagnostics::Deploy",
			", s s": "outline::Toggle",
			// Format
			", c f": "editor::Format",
			// File explorer
			", e": "workspace::ToggleLeftDock",
			// Telescope
			", f f": "file_finder::Toggle",
			", space": "file_finder::Toggle",
			// Quit zed
			", q q": "zed::Quit",
			// Terminal
			", t": "workspace::ToggleBottomDock",
			// Windows management
			", w s": "pane::SplitDown",
			", w v": "pane::SplitRight",
			", w d": "pane::CloseAllItems",
			// Jump to hunks
			"] h": "editor::GoToHunk",
			"[ h": "editor::GoToPreviousHunk",
			// Jump to diagnostic
			"] d": "editor::GoToDiagnostic",
			"[ d": "editor::GoToPreviousDiagnostic",
			// Excerpts
			// (excerpts are the little splits in multi-buffers when doing a search)
			"] e": "editor::MoveToStartOfNextExcerpt",
			"[ e": "editor::MoveToStartOfExcerpt"
		}
	},
	{
		"context": "Editor && vim_mode == visual && !VimWaiting && !VimObject",
		"bindings": {
			// Line's Motions
			"shift-j": "editor::MoveLineDown",
			"shift-k": "editor::MoveLineUp"
		}
	},
	// Center the cursor on the screen when scrolling and find all references
	{
		"context": "VimControl && !menu",
		"bindings": {
			"ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
			"ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
			"n": ["workspace::SendKeystrokes", "n z z z v"],
			"shift-n": ["workspace::SendKeystrokes", "shift-n z z z v"],
			"shift-g": ["workspace::SendKeystrokes", "shift-g z z"],
			"g r": "editor::FindAllReferences"
		}
	},
	{
		"context": "vim_operator == d",
		"bindings": {
			"o": "editor::ExpandAllDiffHunks",
			"r": "git::Restore"
		}
	},
	{
		"context": "vim_mode == normal || vim_mode == visual",
		"bindings": {
			"s": "vim::PushSneak",
			"S": "vim::PushSneakBackward"
		}
	},
	{
		"context": "vim_operator == a || vim_operator == i || vim_operator == cs",
		"bindings": {
			"b": "vim::AnyBrackets",
			"t": "vim::Tag",
			"q": "vim::AnyQuotes"
		}
	}
]
